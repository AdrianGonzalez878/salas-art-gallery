# Salas Art Gallery — copia este archivo a .env.local y rellena con credenciales NUEVAS
# (nunca reutilices las de Conchita Plata)

# Sanity (proyecto nuevo "Salas Art Gallery")
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Mercado Pago (cuenta nueva de Salas)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Resend (cuenta nueva de Salas + dominio verificado)
RESEND_API_KEY=

# Admin / sesión
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# URLs del sitio (local o Vercel de Salas)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Revalidación Sanity webhook
SANITY_REVALIDATE_SECRET=

# Pixels (opcionales; dejar vacíos hasta tener los de Salas)
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Hero — preview de video local (opcional; no cambia el schema de Sanity)
# Copia tus archivos a public/videos/ y descomenta:
# Hero media se gestiona desde Sanity Studio → Hero Section (video o imágenes).
# Las variables siguientes ya no se usan:
# NEXT_PUBLIC_HERO_VIDEO=/videos/hero.mp4
# NEXT_PUBLIC_HERO_VIDEO_MOBILE=/videos/hero-vertical.mp4
